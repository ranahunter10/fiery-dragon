# SPDX-License-Identifier: MIT
# Fiery Dragon build (ADR-0002): vendored libbpf v1.7.0 and bpftool v7.7.0,
# BPF programs compiled with clang against bpf/vmlinux/vmlinux.h (CO-RE),
# skeletons generated by the vendored bpftool, loaders linked statically
# against the vendored libbpf. Everything is built under $(OUT).
#
#   make            build everything
#   make check      unit tests, evidence and vmlinux checksums, build
#   make smoke      load the smoke objects (needs root: sudo make smoke)
#   make schema       regenerate schema/generated/ from schema/records.toml (ADR-0008)
#   make layout-check three-way layout check: generator vs BTF vs numpy
#   make test-c-asan  the C unit tests under ASan and UBSan
#   make mutate-wal   mutation sweep of the WAL writer
#   make clean
#
# Build dependencies: clang, gcc, make, pkg-config, libelf-dev, zlib1g-dev, libssl-dev.
#
# First checkout: git submodule update --init --recursive

OUT       ?= build
CLANG     ?= clang
CC        ?= cc
ARCH      := x86

LIBBPF_SRC  := third_party/libbpf/src
BPFTOOL_SRC := third_party/bpftool/src
LIBBPF_DIR  := $(abspath $(OUT)/libbpf)
LIBBPF_A    := $(LIBBPF_DIR)/libbpf.a
BPFTOOL     := $(abspath $(OUT)/bpftool)/bootstrap/bpftool

# -fms-extensions: kernel 7.0's BTF has anonymous tagged members (e.g. "struct aes_enckey;"
# inside struct aes_key), as the kernel itself is built with -fms-extensions. Without it,
# clang rejects vmlinux.h (E-0059).
BPF_CFLAGS := -g -O2 -target bpf -D__TARGET_ARCH_$(ARCH) -Wall -Werror \
              -fms-extensions -Wno-microsoft-anon-tag -Ibpf/vmlinux -Ischema/generated -Ibpf/include -I$(LIBBPF_DIR)
CFLAGS     ?= -O2 -g
CFLAGS     += -std=gnu11 -Wall -Wextra -Werror -I$(LIBBPF_DIR) -I$(OUT) -Ischema/generated -Ibpf/include -Idaemon
LDLIBS     := $(LIBBPF_A) -lelf -lz

SMOKE := $(OUT)/core_smoke $(OUT)/load_check $(OUT)/empty.bpf.o
SPINE := $(OUT)/p15-spine $(OUT)/test_selftest $(OUT)/test_wal
DAEMON_COMMON := daemon/records.c daemon/selftest.c
WAL_SRC := daemon/wal.c daemon/crc32c.c

.PHONY: all check smoke clean submodules deps schema schema-check layout-check test-c test-c-asan mutate-wal
.SECONDARY:              # keep the .bpf.o objects (veristat and inspection)
all: $(SMOKE) $(SPINE)

$(OUT):
	mkdir -p $@

# Build dependencies, checked up front so a missing one fails with the package name.
# bpftool v7.7.0 links libcrypto unconditionally (program signing, sign.c), so libssl-dev
# is required (E-0061).
DEP_HEADERS := libelf.h:libelf-dev zlib.h:zlib1g-dev openssl/opensslv.h:libssl-dev
deps:
	@missing=; for d in $(DEP_HEADERS); do h=$${d%%:*}; p=$${d##*:}; \
	  echo "#include <$$h>" | $(CC) -E -x c - >/dev/null 2>&1 || missing="$$missing $$p"; done; \
	  if [ -n "$$missing" ]; then echo "missing build dependencies, install:$$missing"; exit 1; fi

submodules:
	@test -f $(LIBBPF_SRC)/libbpf.h && test -f $(BPFTOOL_SRC)/main.c || \
	  { echo "submodules missing: git submodule update --init --recursive"; exit 1; }

$(LIBBPF_A): | deps submodules
	$(MAKE) -C $(LIBBPF_SRC) BUILD_STATIC_ONLY=1 OBJDIR=$(LIBBPF_DIR)/obj \
	  DESTDIR=$(LIBBPF_DIR) INCLUDEDIR= LIBDIR= UAPIDIR= install install_uapi_headers

$(BPFTOOL): | deps submodules
	mkdir -p $(abspath $(OUT)/bpftool)
	$(MAKE) -C $(BPFTOOL_SRC) ARCH= CROSS_COMPILE= OUTPUT=$(abspath $(OUT)/bpftool)/ bootstrap

$(OUT)/%.bpf.o: bpf/test/%.bpf.c bpf/vmlinux/vmlinux.h $(LIBBPF_A) | $(OUT)
	$(CLANG) $(BPF_CFLAGS) -c $< -o $@

# empty.bpf.c includes <linux/bpf.h>; the vendored uapi headers provide it.
$(OUT)/empty.bpf.o: bpf/test/empty.bpf.c $(LIBBPF_A) | $(OUT)
	$(CLANG) -g -O2 -target bpf -Wall -Werror -I$(LIBBPF_DIR) -I/usr/include/$(shell uname -m)-linux-gnu -c $< -o $@

SCHEMA_GEN := schema/generated/p15_records.h schema/generated/p15_records.py \
              schema/generated/RECORDS.md schema/generated/p15_layout_probe.bpf.c

schema:
	python3 schema/gen/gen.py

schema-check:
	python3 schema/gen/gen.py --check

$(OUT)/p15_layout_probe.bpf.o: schema/generated/p15_layout_probe.bpf.c schema/generated/p15_records.h \
                               bpf/vmlinux/vmlinux.h $(LIBBPF_A) | $(OUT)
	$(CLANG) $(BPF_CFLAGS) -c $< -o $@

layout-check: $(OUT)/p15_layout_probe.bpf.o $(BPFTOOL)
	$(BPFTOOL) -j btf dump file $< > $(OUT)/layout_btf.json
	python3 schema/gen/layout_check.py $(OUT)/layout_btf.json

$(OUT)/%.bpf.o: bpf/progs/%.bpf.c bpf/vmlinux/vmlinux.h schema/generated/p15_records.h \
                bpf/include/p15_counters.h $(LIBBPF_A) | $(OUT)
	$(CLANG) $(BPF_CFLAGS) -c $< -o $@

$(OUT)/p15-spine: daemon/p15_spine.c $(DAEMON_COMMON) daemon/*.h $(OUT)/spine.skel.h $(LIBBPF_A)
	$(CC) $(CFLAGS) daemon/p15_spine.c $(DAEMON_COMMON) $(LDLIBS) -o $@

$(OUT)/test_selftest: daemon/tests/test_selftest.c $(DAEMON_COMMON) daemon/*.h $(LIBBPF_A) | $(OUT)
	$(CC) $(CFLAGS) daemon/tests/test_selftest.c $(DAEMON_COMMON) $(LDLIBS) -o $@

$(OUT)/test_wal: daemon/tests/test_wal.c $(WAL_SRC) daemon/wal.h daemon/crc32c.h | $(OUT)
	$(CC) $(CFLAGS) daemon/tests/test_wal.c $(WAL_SRC) -o $@

test-c: $(OUT)/test_selftest $(OUT)/test_wal
	$(OUT)/test_selftest
	$(OUT)/test_wal

# The same C tests under AddressSanitizer and UndefinedBehaviorSanitizer: any leak,
# out-of-bounds access or undefined behaviour fails the run.
ASAN := -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer
test-c-asan: $(LIBBPF_A) | $(OUT)
	mkdir -p $(OUT)/asan
	$(CC) $(CFLAGS) $(ASAN) daemon/tests/test_wal.c $(WAL_SRC) -o $(OUT)/asan/test_wal
	$(CC) $(CFLAGS) $(ASAN) daemon/tests/test_selftest.c $(DAEMON_COMMON) $(LDLIBS) -o $(OUT)/asan/test_selftest
	$(OUT)/asan/test_wal
	$(OUT)/asan/test_selftest

mutate-wal:
	python3 daemon/tests/mutate_wal.py

$(OUT)/%.skel.h: $(OUT)/%.bpf.o $(BPFTOOL)
	$(BPFTOOL) gen skeleton $< > $@

$(OUT)/core_smoke: bpf/test/core_smoke.c $(OUT)/core_smoke.skel.h $(LIBBPF_A)
	$(CC) $(CFLAGS) $< $(LDLIBS) -o $@

$(OUT)/load_check: bpf/test/load_check.c $(LIBBPF_A)
	$(CC) $(CFLAGS) $< $(LDLIBS) -o $@

check: all schema-check layout-check test-c
	tools/ci/run-tests.sh
	tools/ci/check-evidence.sh
	cd bpf/vmlinux && sha256sum -c --quiet SHA256SUMS && echo "ok    bpf/vmlinux/SHA256SUMS"

smoke: all
	$(OUT)/load_check $(OUT)/empty.bpf.o
	$(OUT)/core_smoke --attach
	$(OUT)/p15-spine selftest

clean:
	rm -rf $(OUT)
